---
// Script côté serveur
let isAuthenticated = false;
let authError = false;

// Si on est en développement local, on considère qu'on est déjà authentifié
// if (import.meta.env.DEV) {
//   isAuthenticated = true;
// }

// Vérifier si une session est déjà active
const hasSession = Astro.cookies.has('site-auth');
if (hasSession) {
  const sessionCookie = Astro.cookies.get('site-auth');
  // Correction Linter: Vérifier si le cookie existe avant d'accéder à .value
  if (sessionCookie) { 
    const sessionValue = sessionCookie.value;
    isAuthenticated = sessionValue === 'authenticated';
  }
}

// Traiter le formulaire de connexion
if (Astro.request.method === 'POST') {
  // Nouveau log pour vérifier si le bloc POST est atteint
  console.log('>>> POST Request Received <<<'); 
  try {
    const formData = await Astro.request.formData();
    const password = formData.get('password');
    
    // Vérifier le mot de passe (à remplacer par votre mot de passe)
    // Utilisez une variable d'environnement pour plus de sécurité
    const sitePassword = import.meta.env.SITE_PASSWORD || 'votremotdepasse';

    // Log de débogage
    console.log('--- Password Debug ---');
    console.log('Password from form:', password);
    console.log('Password from .env:', sitePassword);
    console.log('Type of form password:', typeof password);
    console.log('Type of env password:', typeof sitePassword);
    console.log('Passwords Match?:', password === sitePassword);
    console.log('----------------------');
    
    if (password === sitePassword) {
      isAuthenticated = true;
      
      // Définir un cookie de session
      Astro.cookies.set('site-auth', 'authenticated', {
        path: '/',
        httpOnly: true,
        secure: import.meta.env.PROD,
        maxAge: 60 * 60 * 24 * 7, // 7 jours
      });
    } else {
      authError = true;
    }
  } catch (error) {
    console.error('Erreur lors du traitement du formulaire:', error);
  }
}
---

{!isAuthenticated && (
  <div class="fixed inset-0 bg-gray-900 bg-opacity-90 flex items-center justify-center p-4 z-50">
    <div class="bg-white dark:bg-gray-800 p-8 rounded-lg shadow-xl max-w-md w-full">
      <div class="flex justify-center mb-6">
        <!-- Logo de NJI Auto Pro -->
        <img src="/logo.svg" alt="NJI Auto Pro" class="h-12" onerror="this.src='/logo.png'; this.onerror=null;" />
      </div>
      
      <h1 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white text-center">Site en construction</h1>
      <p class="mb-6 text-gray-700 dark:text-gray-300 text-center">Ce site est actuellement en phase de développement. Veuillez vous authentifier pour y accéder.</p>
      
      <form method="POST" class="space-y-4">
        {authError && (
          <div class="p-3 bg-red-100 text-red-700 rounded text-center">
            Mot de passe incorrect. Veuillez réessayer.
          </div>
        )}
        <div>
          <label for="password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Mot de passe</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:text-white"
            autocomplete="current-password"
          />
        </div>
        <button 
          type="submit" 
          class="w-full py-2 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-md transition duration-150"
        >
          Accéder au site
        </button>
      </form>
    </div>
  </div>
)}
