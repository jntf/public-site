---
// Pour activer la protection par mot de passe (`PasswordProtection.astro`) sur l'ensemble du site,
// toutes les pages utilisant ce layout doivent être rendues côté serveur (SSR).
// Cela permet au composant de traiter la soumission du formulaire POST.
// Lorsque vous supprimez la protection par mot de passe, commentez ou supprimez la ligne
// `export const prerender = false;` ci-dessous pour que les pages redeviennent statiques (SSG), 
// sauf si elles ont d'autres raisons d'être SSR.
export const prerender = false;

import { SEO } from "astro-seo";
import Header from "../components/core/Header.astro";
import Footer from "../components/core/Footer.astro";
import PasswordProtection from "../components/auth/PasswordProtection.astro";
import "../styles/global.css";
import  SpeedInsights  from "@vercel/speed-insights/astro"

// Props pour le SEO et le contenu
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noIndex?: boolean;
  noFollow?: boolean;
}

// Valeurs par défaut
const {
  title = "NJI Auto Pro - Plateforme B2B pour professionnels de l'automobile",
  description = "Plateforme innovante B2B dédiée aux professionnels de l'automobile, offrant des solutions de gestion de parc et de vente par lots.",
  image = "/images/og-default.jpg",
  canonical,
  noIndex = false,
  noFollow = false,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicons -->
    <link rel="icon" href="favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <SEO
      title={title}
      description={description}
      canonical={canonical || Astro.url.pathname}
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: image,
        },
        optional: {
          description: description,
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: title,
        description: description,
        image: image,
      }}
      extend={{
        meta: [
          { name: "theme-color", content: "#6DD8A4" },
          { name: "mobile-web-app-capable", content: "yes" },
          {
            name: "apple-mobile-web-app-status-bar-style",
            content: "black-translucent",
          },
          ...(noIndex ? [{ name: "robots", content: "noindex" }] : []),
          ...(noFollow ? [{ name: "robots", content: "nofollow" }] : []),
        ],
        link: [
          { rel: "preconnect", href: "https://fonts.googleapis.com" },
          {
            rel: "preconnect",
            href: "https://fonts.gstatic.com",
            crossorigin: "anonymous",
          },
          {
            rel: "stylesheet",
            href: "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap",
          },
        ],
      }}
    />
  </head>
  <body class="bg-white dark:bg-gray-900">
    <PasswordProtection />
    <SpeedInsights />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
