---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout
  title="Carrières - NJI Auto Pro"
  description="Rejoignez l'équipe NJI Auto Pro et participez à la transformation du secteur automobile."
>
  <!-- Hero Section -->
  <section class="pt-24 pb-16 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-800">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] text-sm font-light mb-6">
          <span class="flex h-2 w-2 rounded-full bg-[var(--color-primary-700)] mr-2"></span>
          Rejoignez-nous
        </div>
        <h1 class="text-4xl md:text-5xl font-light text-gray-900 dark:text-white mb-6 leading-tight">
          Carrières chez NJI Auto Pro
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
          Rejoignez notre équipe innovante et participez à la transformation digitale du secteur automobile professionnel.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button 
            variant="green"
            size="lg"
            href="#postes-ouverts"
            class="px-8 py-4 rounded-md"
          >
            Voir nos postes ouverts
          </Button>
          <Button 
            variant="outline"
            size="lg"
            href="#candidature-spontanee"
            class="px-8 py-4 rounded-md"
          >
            Candidature spontanée
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Notre culture -->
  <section class="py-16 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div>
            <div class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] text-sm font-light mb-6">
              <span class="flex h-2 w-2 rounded-full bg-[var(--color-primary-700)] mr-2"></span>
              Notre culture
            </div>
            <h2 class="text-3xl font-light text-gray-900 dark:text-white mb-6">
              Une entreprise innovante au service des professionnels
            </h2>
            <div class="prose prose-lg dark:prose-invert">
              <p>
                Chez NJI Auto Pro, nous croyons que la transformation digitale du secteur automobile est une opportunité unique pour les professionnels.
              </p>
              <p>
                Notre équipe multidisciplinaire partage une passion commune pour la technologie, l'innovation et l'automobile. Nous travaillons chaque jour à développer des solutions innovantes qui répondent aux défis spécifiques des professionnels du secteur.
              </p>
              <p>
                Rejoindre NJI Auto Pro, c'est intégrer une entreprise en pleine croissance où votre expertise sera valorisée et où vous aurez un impact réel sur l'évolution du marché automobile professionnel.
              </p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="aspect-square bg-gray-200 dark:bg-gray-700 rounded-xl flex items-center justify-center">
              <span class="text-gray-500 dark:text-gray-400">Image 1</span>
            </div>
            <div class="aspect-square bg-gray-200 dark:bg-gray-700 rounded-xl flex items-center justify-center">
              <span class="text-gray-500 dark:text-gray-400">Image 2</span>
            </div>
            <div class="aspect-square bg-gray-200 dark:bg-gray-700 rounded-xl flex items-center justify-center">
              <span class="text-gray-500 dark:text-gray-400">Image 3</span>
            </div>
            <div class="aspect-square bg-gray-200 dark:bg-gray-700 rounded-xl flex items-center justify-center">
              <span class="text-gray-500 dark:text-gray-400">Image 4</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nos valeurs -->
  <section class="py-16 bg-gray-50 dark:bg-gray-800">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-4xl mx-auto mb-12">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] text-sm font-light mb-6">
            <span class="flex h-2 w-2 rounded-full bg-[var(--color-primary-700)] mr-2"></span>
            Nos valeurs
          </div>
          <h2 class="text-3xl font-light text-gray-900 dark:text-white mb-6">
            Ce qui nous définit
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-300">
            Nos valeurs guident nos actions au quotidien et définissent notre façon de travailler ensemble et avec nos clients.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Valeur 1 -->
          <div class="bg-white dark:bg-gray-900 rounded-xl p-8 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-lg flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[var(--color-primary-700)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-3">Innovation</h3>
            <p class="text-gray-600 dark:text-gray-300">
              Nous repoussons constamment les limites de ce qui est possible, en recherchant des solutions créatives aux défis complexes du secteur automobile.
            </p>
          </div>
          
          <!-- Valeur 2 -->
          <div class="bg-white dark:bg-gray-900 rounded-xl p-8 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-lg flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[var(--color-primary-700)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-3">Collaboration</h3>
            <p class="text-gray-600 dark:text-gray-300">
              Nous croyons en la puissance du travail d'équipe, tant en interne qu'avec nos clients, pour créer des solutions qui répondent réellement aux besoins du marché.
            </p>
          </div>
          
          <!-- Valeur 3 -->
          <div class="bg-white dark:bg-gray-900 rounded-xl p-8 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-lg flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[var(--color-primary-700)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-3">Fiabilité</h3>
            <p class="text-gray-600 dark:text-gray-300">
              La confiance est au cœur de nos relations. Nous tenons nos engagements et fournissons des solutions robustes et fiables pour accompagner nos clients au quotidien.
            </p>
          </div>
          
          <!-- Valeur 4 -->
          <div class="bg-white dark:bg-gray-900 rounded-xl p-8 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-lg flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[var(--color-primary-700)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-3">Excellence</h3>
            <p class="text-gray-600 dark:text-gray-300">
              Nous visons l'excellence dans tout ce que nous faisons, de la conception de nos produits à notre service client, en passant par nos processus internes.
            </p>
          </div>
          
          <!-- Valeur 5 -->
          <div class="bg-white dark:bg-gray-900 rounded-xl p-8 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-lg flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[var(--color-primary-700)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-3">Transparence</h3>
            <p class="text-gray-600 dark:text-gray-300">
              Nous croyons en une communication ouverte et honnête, tant au sein de notre équipe qu'avec nos clients et partenaires.
            </p>
          </div>
          
          <!-- Valeur 6 -->
          <div class="bg-white dark:bg-gray-900 rounded-xl p-8 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-lg flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[var(--color-primary-700)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-3">Bien-être</h3>
            <p class="text-gray-600 dark:text-gray-300">
              Nous favorisons un environnement de travail positif et équilibré, où chacun peut s'épanouir professionnellement et personnellement.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Avantages -->
  <section class="py-16 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-4xl mx-auto mb-12">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] text-sm font-light mb-6">
            <span class="flex h-2 w-2 rounded-full bg-[var(--color-primary-700)] mr-2"></span>
            Avantages
          </div>
          <h2 class="text-3xl font-light text-gray-900 dark:text-white mb-6">
            Pourquoi nous rejoindre?
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-300">
            Découvrez les avantages de faire partie de l'équipe NJI Auto Pro.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Avantage 1 -->
          <div class="flex items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-full flex items-center justify-center mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[var(--color-primary-700)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-2">Flexibilité de travail</h3>
              <p class="text-gray-600 dark:text-gray-300">
                Travail hybride, horaires flexibles et possibilité de télétravail partiel pour un meilleur équilibre vie professionnelle/vie personnelle.
              </p>
            </div>
          </div>
          
          <!-- Avantage 2 -->
          <div class="flex items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-full flex items-center justify-center mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[var(--color-primary-700)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-2">Développement professionnel</h3>
              <p class="text-gray-600 dark:text-gray-300">
                Budget formation annuel, accès à des conférences et événements, mentorat interne et opportunités d'évolution.
              </p>
            </div>
          </div>
          
          <!-- Avantage 3 -->
          <div class="flex items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-full flex items-center justify-center mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[var(--color-primary-700)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-2">Rémunération attractive</h3>
              <p class="text-gray-600 dark:text-gray-300">
                Salaires compétitifs, participation aux bénéfices, prime annuelle basée sur la performance et possibilité de BSPCE.
              </p>
            </div>
          </div>
          
          <!-- Avantage 4 -->
          <div class="flex items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-full flex items-center justify-center mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[var(--color-primary-700)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-2">Avantages sociaux</h3>
              <p class="text-gray-600 dark:text-gray-300">
                Mutuelle santé familiale prise en charge à 70%, tickets restaurant, comité d'entreprise actif et congés exceptionnels.
              </p>
            </div>
          </div>
          
          <!-- Avantage 5 -->
          <div class="flex items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-full flex items-center justify-center mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[var(--color-primary-700)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-2">Environnement stimulant</h3>
              <p class="text-gray-600 dark:text-gray-300">
                Équipe diverse et passionnée, bureaux modernes en centre-ville, événements d'équipe réguliers et culture d'entreprise positive.
              </p>
            </div>
          </div>
          
          <!-- Avantage 6 -->
          <div class="flex items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-full flex items-center justify-center mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[var(--color-primary-700)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-2">Innovation et impact</h3>
              <p class="text-gray-600 dark:text-gray-300">
                Participez à des projets innovants qui transforment le secteur automobile et ayez un impact réel sur l'évolution du marché.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Postes ouverts -->
  <section id="postes-ouverts" class="py-16 bg-gray-50 dark:bg-gray-800">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-4xl mx-auto mb-12">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] text-sm font-light mb-6">
            <span class="flex h-2 w-2 rounded-full bg-[var(--color-primary-700)] mr-2"></span>
            Rejoignez-nous
          </div>
          <h2 class="text-3xl font-light text-gray-900 dark:text-white mb-6">
            Postes ouverts
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-300">
            Découvrez nos opportunités actuelles et rejoignez notre équipe.
          </p>
        </div>
        
        <div class="mb-8">
          <div class="flex flex-wrap items-center justify-center gap-3">
            <button class="px-4 py-2 bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] rounded-full font-medium transition-colors hover:bg-[var(--color-primary-700)]/20">
              Tous les postes
            </button>
            <button class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full transition-colors hover:bg-gray-200 dark:hover:bg-gray-600">
              Technique
            </button>
            <button class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full transition-colors hover:bg-gray-200 dark:hover:bg-gray-600">
              Marketing
            </button>
            <button class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full transition-colors hover:bg-gray-200 dark:hover:bg-gray-600">
              Commercial
            </button>
            <button class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full transition-colors hover:bg-gray-200 dark:hover:bg-gray-600">
              Support
            </button>
          </div>
        </div>
        
        <div class="space-y-4">
          <!-- Poste 1 -->
          <div class="bg-white dark:bg-gray-900 rounded-xl overflow-hidden shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow">
            <div class="p-6">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                  <div class="flex items-center mb-2">
                    <span class="inline-block px-3 py-1 bg-indigo-100 dark:bg-indigo-900 text-indigo-800 dark:text-indigo-200 text-xs font-medium rounded-full mr-2">
                      Technique
                    </span>
                    <span class="inline-block px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 text-xs font-medium rounded-full">
                      CDI
                    </span>
                  </div>
                  <h3 class="text-xl font-medium text-gray-900 dark:text-white">
                    Développeur Full Stack TypeScript / Vue.js
                  </h3>
                  <div class="flex items-center mt-2 text-sm text-gray-500 dark:text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    Paris (Hybride) · 
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
