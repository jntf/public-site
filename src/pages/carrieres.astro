<script>
  // Script pour la gestion du file upload
  document.addEventListener('DOMContentLoaded', () => {
    const fileInput = document.getElementById('cv-upload');
    const fileLabel = document.querySelector('label[for="cv-upload"]');
    
    if (fileInput && fileLabel) {
      fileInput.addEventListener('change', (e) => {
        const fileName = e.target.files[0]?.name;
        
        if (fileName) {
          const fileInfo = document.createElement('p');
          fileInfo.className = 'text-sm text-gray-700 dark:text-gray-300 mt-2';
          fileInfo.textContent = `Fichier sélectionné: ${fileName}`;
          
          // Remove previous file info if exists
          const prevFileInfo = fileLabel.nextElementSibling;
          if (prevFileInfo && prevFileInfo.textContent?.startsWith('Fichier sélectionné:')) {
            prevFileInfo.remove();
          }
          
          fileLabel.parentNode.appendChild(fileInfo);
        }
      });
    }
  });

  // Smooth scrolling for anchor links
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        
        const target = document.querySelector(this.getAttribute('href'));
        
        if (target) {
          window.scrollTo({
            top: target.offsetTop - 100,
            behavior: 'smooth'
          });
        }
      });
    });
  });
</script>
