<script>
  // Gestion du toggle mensuel/annuel
  document.addEventListener('DOMContentLoaded', () => {
    const monthlyToggle = document.getElementById('monthly-toggle');
    const annualToggle = document.getElementById('annual-toggle');
    
    const starterPrice = document.getElementById('starter-price');
    const proPrice = document.getElementById('pro-price');
    
    const monthlyPrices = {
      starter: '99€',
      pro: '249€'
    };
    
    const annualPrices = {
      starter: '84€',
      pro: '212€'
    };
    
    if (monthlyToggle && annualToggle) {
      monthlyToggle.addEventListener('click', () => {
        // UI update
        monthlyToggle.classList.add('bg-white', 'dark:bg-gray-700', 'shadow-sm', 'text-gray-900', 'dark:text-white');
        monthlyToggle.classList.remove('text-gray-700', 'dark:text-gray-300');
        
        annualToggle.classList.remove('bg-white', 'dark:bg-gray-700', 'shadow-sm', 'text-gray-900', 'dark:text-white');
        annualToggle.classList.add('text-gray-700', 'dark:text-gray-300');
        
        // Update prices
        if (starterPrice) starterPrice.textContent = monthlyPrices.starter;
        if (proPrice) proPrice.textContent = monthlyPrices.pro;
      });
      
      annualToggle.addEventListener('click', () => {
        // UI update
        annualToggle.classList.add('bg-white', 'dark:bg-gray-700', 'shadow-sm', 'text-gray-900', 'dark:text-white');
        annualToggle.classList.remove('text-gray-700', 'dark:text-gray-300');
        
        monthlyToggle.classList.remove('bg-white', 'dark:bg-gray-700', 'shadow-sm', 'text-gray-900', 'dark:text-white');
        monthlyToggle.classList.add('text-gray-700', 'dark:text-gray-300');
        
        // Update prices
        if (starterPrice) starterPrice.textContent = annualPrices.starter;
        if (proPrice) proPrice.textContent = annualPrices.pro;
      });
    }
  });
</script>
