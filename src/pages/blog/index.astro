---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import { getArticles } from "../../lib/contentful";

// Récupérer les articles depuis Contentful
let articles = [];
let fetchError = null;

try {
  articles = await getArticles({ limit: 10 });
} catch (error) {
  console.error("Erreur lors de la récupération des articles:", error);
  fetchError = error.message || "Une erreur s'est produite lors de la récupération des articles.";
}

// Séparer les articles en vedette et les articles récents
const featuredArticles = articles.slice(0, 2);
const recentArticles = articles.slice(2, 8);

// Fonction pour formater la date
function formatDate(dateString) {
  if (!dateString) return '';
  return new Date(dateString).toLocaleDateString('fr-FR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout
  title="Expertise Automobile - NJI Auto Pro"
  description="Actualités, tendances et conseils pour les professionnels de l'automobile - NJI Auto Pro"
>
  <!-- Hero Section -->
  <section class="pt-24 pb-12 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-800">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] text-sm font-light mb-6">
          <span class="flex h-2 w-2 rounded-full bg-[var(--color-primary-700)] mr-2"></span>
          Actualités & Insights
        </div>
        <h1 class="text-4xl md:text-5xl font-light text-gray-900 dark:text-white mb-6 leading-tight">
          Expertise Automobile
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-8">
          Découvrez les dernières actualités, tendances et conseils pour les professionnels de l'automobile.
        </p>
      </div>
    </div>
  </section>

  <!-- Message d'erreur si nécessaire -->
  {fetchError && (
    <section class="py-8 bg-white dark:bg-gray-900">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto bg-red-50 border-l-4 border-red-500 p-4 mb-8">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-500" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm text-red-700">
                <strong>Erreur de chargement des articles :</strong> {fetchError}
              </p>
              <p class="mt-2 text-sm text-red-700">
                Veuillez consulter la <a href="/contentful-test" class="font-medium underline">page de diagnostic Contentful</a> pour résoudre ce problème.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Catégories de blog -->
  <section class="py-8 bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href="/blog" class="px-4 py-2 bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] rounded-full font-medium transition-colors hover:bg-[var(--color-primary-700)]/20">
            Tous les articles
          </a>
          <a href="/blog?category=Marché automobile" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full transition-colors hover:bg-gray-200 dark:hover:bg-gray-700">
            Marché automobile
          </a>
          <a href="/blog?category=Tendances" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full transition-colors hover:bg-gray-200 dark:hover:bg-gray-700">
            Tendances
          </a>
          <a href="/blog?category=Conseils pro" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full transition-colors hover:bg-gray-200 dark:hover:bg-gray-700">
            Conseils pro
          </a>
          <a href="/blog?category=Technologie" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full transition-colors hover:bg-gray-200 dark:hover:bg-gray-700">
            Technologie
          </a>
          <a href="/blog?category=Réglementation" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full transition-colors hover:bg-gray-200 dark:hover:bg-gray-700">
            Réglementation
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Articles en vedette -->
  <section class="py-12 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl font-light text-gray-900 dark:text-white mb-8">Articles en vedette</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          {featuredArticles.length > 0 ? (
            featuredArticles.map((article) => (
              <div class="bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow">
                <div class="aspect-video bg-gray-200 dark:bg-gray-700 relative">
                  {article.fields.featuredImage ? (
                    <img 
                      src={`${article.fields.featuredImage.fields.file.url}?w=600&h=400&fit=fill&f=faces`}
                      alt={article.fields.featuredImage.fields.title || article.fields.title}
                      class="object-cover w-full h-full"
                    />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center">
                      <span class="text-gray-500 dark:text-gray-400">Image de l'article</span>
                    </div>
                  )}
                  <div class="absolute top-4 left-4">
                    <span class="px-3 py-1 bg-[var(--color-primary-700)]/80 text-white text-xs font-medium rounded-full">
                      {article.fields.category || 'Expertise'}
                    </span>
                  </div>
                </div>
                <div class="p-6">
                  <div class="flex items-center mb-3">
                    <span class="text-sm text-gray-500 dark:text-gray-400">{formatDate(article.fields.publicationDate)}</span>
                    <span class="mx-2 text-gray-300 dark:text-gray-600">•</span>
                    <span class="text-sm text-gray-500 dark:text-gray-400">{article.fields.readingTime || '5 min de lecture'}</span>
                  </div>
                  <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-3">
                    <a href={`/blog/${article.fields.slug}`}>
                      {article.fields.title}
                    </a>
                  </h3>
                  <p class="text-gray-600 dark:text-gray-300 mb-4">
                    {article.fields.excerpt || 'Description de l\'article non disponible.'}
                  </p>
                  <div class="flex items-center">
                    <div class="w-10 h-10 rounded-full bg-gray-200 dark:bg-gray-700 mr-3 flex items-center justify-center">
                      <span class="text-xs text-gray-500 dark:text-gray-400">{article.fields.authorInitials || article.fields.author?.[0] || '?'}</span>
                    </div>
                    <span class="text-sm font-medium text-gray-900 dark:text-white">{article.fields.author || 'Auteur non spécifié'}</span>
                  </div>
                </div>
              </div>
            ))
          ) : (
            <div class="col-span-2 bg-yellow-50 dark:bg-gray-800 rounded-xl p-8 text-center border border-yellow-100 dark:border-gray-700">
              <h3 class="text-xl font-medium text-yellow-800 dark:text-yellow-400 mb-4">Aucun article disponible</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                Vous n'avez pas encore créé d'articles dans Contentful ou le modèle de contenu n'est pas correctement configuré.
              </p>
              <div class="space-y-4">
                <a href="/contentful-test" class="inline-block px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                  Vérifier la configuration Contentful
                </a>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Articles récents -->
  {articles.length > 0 && (
    <section class="py-12 bg-gray-50 dark:bg-gray-800">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-2xl font-light text-gray-900 dark:text-white mb-8">Articles récents</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            {recentArticles.length > 0 ? (
              recentArticles.map((article) => (
                <div class="bg-white dark:bg-gray-900 rounded-xl overflow-hidden shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow">
                  <div class="aspect-video bg-gray-200 dark:bg-gray-700 relative">
                    {article.fields.featuredImage ? (
                      <img 
                        src={`${article.fields.featuredImage.fields.file.url}?w=400&h=225&fit=fill&f=faces`}
                        alt={article.fields.featuredImage.fields.title || article.fields.title}
                        class="object-cover w-full h-full"
                      />
                    ) : (
                      <div class="absolute inset-0 flex items-center justify-center">
                        <span class="text-gray-500 dark:text-gray-400">Image de l'article</span>
                      </div>
                    )}
                    <div class="absolute top-4 left-4">
                      <span class="px-3 py-1 bg-[var(--color-primary-700)]/80 text-white text-xs font-medium rounded-full">
                        {article.fields.category || 'Expertise'}
                      </span>
                    </div>
                  </div>
                  <div class="p-5">
                    <div class="flex items-center mb-2">
                      <span class="text-sm text-gray-500 dark:text-gray-400">{formatDate(article.fields.publicationDate)}</span>
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">
                      <a href={`/blog/${article.fields.slug}`}>
                        {article.fields.title}
                      </a>
                    </h3>
                    <p class="text-gray-600 dark:text-gray-300 mb-3 text-sm">
                      {article.fields.excerpt || 'Description de l\'article non disponible.'}
                    </p>
                  </div>
                </div>
              ))
            ) : (
              <div class="col-span-3 text-center text-gray-500 dark:text-gray-400">
                <p>Pas d'articles récents à afficher.</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Newsletter -->
  <section class="py-16 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto bg-gray-50 dark:bg-gray-800 rounded-2xl p-8 md:p-10 shadow-sm border border-gray-100 dark:border-gray-700">
        <div class="text-center mb-6">
          <h2 class="text-2xl md:text-3xl font-light text-gray-900 dark:text-white mb-3">
            Restez informé
          </h2>
          <p class="text-gray-600 dark:text-gray-300">
            Inscrivez-vous à notre newsletter pour recevoir nos derniers articles et analyses du secteur automobile.
          </p>
        </div>
        
        <form class="flex flex-col sm:flex-row gap-3">
          <input
            type="email"
            placeholder="Votre email professionnel"
            class="flex-grow px-4 py-3 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[var(--color-primary-700)] focus:border-transparent"
            required
          />
          <Button
            variant="green"
            type="submit"
            class="px-6 py-3 text-base font-medium rounded-md"
          >
            S'inscrire
          </Button>
        </form>
        
        <p class="text-xs text-gray-500 dark:text-gray-400 text-center mt-4">
          En vous inscrivant, vous acceptez notre <a href="/confidentialite" class="underline">politique de confidentialité</a>. Vous pouvez vous désinscrire à tout moment.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
