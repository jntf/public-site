---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import { getArticles, getArticleBySlug } from "../../lib/contentful";
import { documentToHtmlString } from '@contentful/rich-text-html-renderer';
import { BLOCKS, INLINES, MARKS } from '@contentful/rich-text-types';

// Activer le rendu à la demande pour les nouvelles pages
export const prerender = false;

// Générer les routes statiques pour les articles existants (mais permet aussi le rendu dynamique)
export async function getStaticPaths() {
  const articles = await getArticles({ limit: 100 });
  
  return articles.map(article => ({
    params: { slug: article.fields.slug },
  }));
}

// Récupérer l'article par son slug
const { slug } = Astro.params;
const article = await getArticleBySlug(slug);

// Si l'article n'existe pas, afficher une page 404
if (!article) {
  return Astro.redirect('/404');
}

// Options avancées pour le rendu du Rich Text
const richTextOptions = {
  renderMark: {
    [MARKS.BOLD]: (text) => `<strong class="font-bold">${text}</strong>`,
    [MARKS.ITALIC]: (text) => `<em class="italic">${text}</em>`,
    [MARKS.UNDERLINE]: (text) => `<u class="underline">${text}</u>`,
    [MARKS.CODE]: (text) => `<code class="font-mono text-sm bg-gray-100 dark:bg-gray-800 p-1 rounded">${text}</code>`,
  },
  renderNode: {
    [BLOCKS.PARAGRAPH]: (node, next) => 
      `<p class="mb-6 leading-relaxed text-gray-700 dark:text-gray-300">${next(node.content)}</p>`,
    [BLOCKS.HEADING_1]: (node, next) => 
      `<h1 class="text-3xl font-bold mt-8 mb-4 text-gray-900 dark:text-white">${next(node.content)}</h1>`,
    [BLOCKS.HEADING_2]: (node, next) => 
      `<h2 class="text-2xl font-semibold mt-8 mb-4 text-gray-900 dark:text-white">${next(node.content)}</h2>`,
    [BLOCKS.HEADING_3]: (node, next) => 
      `<h3 class="text-xl font-semibold mt-6 mb-3 text-gray-900 dark:text-white">${next(node.content)}</h3>`,
    [BLOCKS.HEADING_4]: (node, next) => 
      `<h4 class="text-lg font-semibold mt-6 mb-3 text-gray-900 dark:text-white">${next(node.content)}</h4>`,
    [BLOCKS.HEADING_5]: (node, next) => 
      `<h5 class="text-base font-semibold mt-4 mb-2 text-gray-900 dark:text-white">${next(node.content)}</h5>`,
    [BLOCKS.HEADING_6]: (node, next) => 
      `<h6 class="text-sm font-semibold mt-4 mb-2 text-gray-900 dark:text-white">${next(node.content)}</h6>`,
    [BLOCKS.UL_LIST]: (node, next) => 
      `<ul class="list-disc pl-8 mb-6 text-gray-700 dark:text-gray-300 space-y-2">${next(node.content)}</ul>`,
    [BLOCKS.OL_LIST]: (node, next) => 
      `<ol class="list-decimal pl-8 mb-6 text-gray-700 dark:text-gray-300 space-y-2">${next(node.content)}</ol>`,
    [BLOCKS.LIST_ITEM]: (node, next) => 
      `<li class="mb-1">${next(node.content)}</li>`,
    [BLOCKS.QUOTE]: (node, next) => 
      `<blockquote class="pl-4 border-l-4 border-gray-300 dark:border-gray-600 italic my-6 text-gray-700 dark:text-gray-300">${next(node.content)}</blockquote>`,
    [BLOCKS.HR]: () => 
      `<hr class="my-8 border-t border-gray-200 dark:border-gray-700">`,
    [BLOCKS.TABLE]: (node, next) => 
      `<div class="overflow-x-auto mb-6"><table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 border border-gray-200 dark:border-gray-700 rounded-lg">${next(node.content)}</table></div>`,
    [BLOCKS.TABLE_ROW]: (node, next) => 
      `<tr class="bg-white dark:bg-gray-800">${next(node.content)}</tr>`,
    [BLOCKS.TABLE_CELL]: (node, next) => 
      `<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300 border-b border-gray-200 dark:border-gray-700">${next(node.content)}</td>`,
    [BLOCKS.TABLE_HEADER_CELL]: (node, next) => 
      `<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider bg-gray-50 dark:bg-gray-700">${next(node.content)}</th>`,
    [BLOCKS.EMBEDDED_ASSET]: (node) => {
      if (node.data && node.data.target && node.data.target.fields) {
        const { file, title, description } = node.data.target.fields;
        const url = file?.url;
        const alt = description || title || 'Image intégrée';
        
        if (url) {
          if (file.contentType.startsWith('image/')) {
            return `<img src="${url}" alt="${alt}" class="my-6 rounded-lg max-w-full h-auto shadow-md" />`;
          } else if (file.contentType.startsWith('video/')) {
            return `<video src="${url}" controls class="my-6 rounded-lg max-w-full shadow-md"><p>Votre navigateur ne prend pas en charge les vidéos HTML5.</p></video>`;
          }
        }
      }
      return `<div class="bg-gray-100 dark:bg-gray-800 p-4 my-6 rounded-lg text-center text-gray-500 dark:text-gray-400">Contenu média non disponible</div>`;
    },
    [INLINES.HYPERLINK]: (node, next) => {
      const { uri } = node.data;
      const isExternal = uri.startsWith('http');
      const externalProps = isExternal ? 'target="_blank" rel="noopener noreferrer"' : '';
      return `<a href="${uri}" ${externalProps} class="text-blue-600 dark:text-blue-400 hover:underline">${next(node.content)}</a>`;
    },
    [INLINES.ENTRY_HYPERLINK]: (node, next) => {
      // Lien vers un autre article
      if (node.data && node.data.target && node.data.target.fields && node.data.target.fields.slug) {
        const slug = node.data.target.fields.slug;
        return `<a href="/blog/${slug}" class="text-blue-600 dark:text-blue-400 hover:underline">${next(node.content)}</a>`;
      }
      return next(node.content);
    },
  }
};

// Convertir le contenu Rich Text en HTML
let contentHtml = '';
if (article.fields.content) {
  contentHtml = documentToHtmlString(article.fields.content, richTextOptions);
}

// Fonction pour formater la date
function formatDate(dateString) {
  if (!dateString) return '';
  return new Date(dateString).toLocaleDateString('fr-FR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// Récupérer quelques articles similaires (par catégorie)
const similarArticles = await getArticles({
  limit: 3,
  'fields.category': article.fields.category,
  'sys.id[ne]': article.sys.id // Exclure l'article courant
});
---

<BaseLayout
  title={`${article.fields.title} - Expertise Automobile - NJI Auto Pro`}
  description={article.fields.excerpt || ''}
>
  <!-- Hero Section -->
  <section class="pt-24 pb-8 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-800">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="mb-6">
          <a href="/blog" class="inline-flex items-center text-[var(--color-primary-700)] hover:underline">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Retour à l'expertise automobile
          </a>
        </div>
        
        <div class="flex items-center mb-4">
          <span class="inline-block px-3 py-1 bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] text-sm font-medium rounded-full">
            {article.fields.category || 'Expertise'}
          </span>
          <span class="mx-2 text-gray-300 dark:text-gray-600">•</span>
          <span class="text-sm text-gray-500 dark:text-gray-400">{formatDate(article.fields.publicationDate)}</span>
          <span class="mx-2 text-gray-300 dark:text-gray-600">•</span>
          <span class="text-sm text-gray-500 dark:text-gray-400">{article.fields.readingTime || '5 min de lecture'}</span>
        </div>
        
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-light text-gray-900 dark:text-white mb-6 leading-tight">
          {article.fields.title}
        </h1>
        
        <div class="flex items-center mb-8">
          <div class="w-12 h-12 rounded-full bg-gray-200 dark:bg-gray-700 mr-4 flex items-center justify-center">
            <span class="text-sm text-gray-500 dark:text-gray-400">{article.fields.authorInitials || article.fields.author?.[0] || '?'}</span>
          </div>
          <div>
            <p class="font-medium text-gray-900 dark:text-white">{article.fields.author || 'Auteur'}</p>
            <p class="text-sm text-gray-500 dark:text-gray-400">{article.fields.authorTitle || 'Expert automobile'}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contenu de l'article -->
  <section class="py-12 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <!-- Image principale -->
        {article.fields.featuredImage ? (
          <img 
            src={`${article.fields.featuredImage.fields.file.url}?w=1200&h=630&fit=fill&f=faces`}
            alt={article.fields.featuredImage.fields.title || article.fields.title}
            class="w-full h-auto aspect-video object-cover rounded-xl mb-10 shadow-md"
          />
        ) : (
          <div class="aspect-video bg-gray-200 dark:bg-gray-700 rounded-xl mb-10 flex items-center justify-center">
            <span class="text-gray-500 dark:text-gray-400">Image non disponible</span>
          </div>
        )}
        
        <!-- Contenu -->
        <article class="rich-text-content mb-12" set:html={contentHtml} />
        
        <!-- Tags -->
        <div class="mb-12">
          <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">Tags</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 text-sm rounded-full">
              #automobile
            </span>
            {article.fields.category && (
              <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 text-sm rounded-full">
                #{article.fields.category.toLowerCase().replace(/\s+/g, '-')}
              </span>
            )}
            <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 text-sm rounded-full">
              #professionnels
            </span>
            <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 text-sm rounded-full">
              #b2b
            </span>
          </div>
        </div>
        
        <!-- Partage -->
        <div class="border-t border-gray-200 dark:border-gray-700 pt-8 mb-12">
          <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">Partager cet article</h3>
          <div class="flex space-x-4">
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="p-2 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.fields.title)}&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="p-2 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
              </svg>
            </a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="p-2 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
            <button onclick={`navigator.clipboard.writeText('${Astro.url.href}'); alert('Lien copié!');`} class="p-2 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                <polyline points="16 6 12 2 8 6"></polyline>
                <line x1="12" y1="2" x2="12" y2="15"></line>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Articles similaires -->
  <section class="py-16 bg-gray-50 dark:bg-gray-800">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl font-light text-gray-900 dark:text-white mb-8 text-center">
          Articles similaires
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {similarArticles.length > 0 ? (
            similarArticles.map((relatedArticle) => (
              <div class="bg-white dark:bg-gray-900 rounded-xl overflow-hidden shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow">
                <div class="aspect-video bg-gray-200 dark:bg-gray-700 relative">
                  {relatedArticle.fields.featuredImage ? (
                    <img 
                      src={`${relatedArticle.fields.featuredImage.fields.file.url}?w=400&h=225&fit=fill&f=faces`}
                      alt={relatedArticle.fields.featuredImage.fields.title || relatedArticle.fields.title}
                      class="object-cover w-full h-full"
                    />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center">
                      <span class="text-gray-500 dark:text-gray-400">Image de l'article</span>
                    </div>
                  )}
                  <div class="absolute top-4 left-4">
                    <span class="px-3 py-1 bg-[var(--color-primary-700)]/80 text-white text-xs font-medium rounded-full">
                      {relatedArticle.fields.category || 'Expertise'}
                    </span>
                  </div>
                </div>
                <div class="p-5">
                  <div class="flex items-center mb-2">
                    <span class="text-sm text-gray-500 dark:text-gray-400">{formatDate(relatedArticle.fields.publicationDate)}</span>
                  </div>
                  <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">
                    <a href={`/blog/${relatedArticle.fields.slug}`}>
                      {relatedArticle.fields.title}
                    </a>
                  </h3>
                  <p class="text-gray-600 dark:text-gray-300 mb-3 text-sm">
                    {relatedArticle.fields.excerpt || 'Description non disponible'}
                  </p>
                </div>
              </div>
            ))
          ) : (
            <div class="col-span-3 bg-white dark:bg-gray-900 rounded-xl p-8 text-center">
              <p class="text-gray-600 dark:text-gray-300">Aucun article similaire pour le moment.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="py-16 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto bg-gray-50 dark:bg-gray-800 rounded-2xl p-8 md:p-10 shadow-sm border border-gray-100 dark:border-gray-700">
        <div class="text-center mb-6">
          <h2 class="text-2xl md:text-3xl font-light text-gray-900 dark:text-white mb-3">
            Restez informé
          </h2>
          <p class="text-gray-600 dark:text-gray-300">
            Inscrivez-vous à notre newsletter pour recevoir nos derniers articles et analyses du secteur automobile.
          </p>
        </div>
        
        <form class="flex flex-col sm:flex-row gap-3">
          <input
            type="email"
            placeholder="Votre email professionnel"
            class="flex-grow px-4 py-3 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[var(--color-primary-700)] focus:border-transparent"
            required
          />
          <Button
            variant="green"
            type="submit"
            class="px-6 py-3 text-base font-medium rounded-md"
          >
            S'inscrire
          </Button>
        </form>
        
        <p class="text-xs text-gray-500 dark:text-gray-400 text-center mt-4">
          En vous inscrivant, vous acceptez notre <a href="/confidentialite" class="underline">politique de confidentialité</a>. Vous pouvez vous désinscrire à tout moment.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Styles supplémentaires pour le contenu Rich Text */
  .rich-text-content :global(h2) {
    font-size: 1.75rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-primary-700);
  }
  
  .rich-text-content :global(h3) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }
  
  .rich-text-content :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }
  
  .rich-text-content :global(a) {
    color: var(--color-primary-700);
    text-decoration: none;
    transition: all 0.2s;
  }
  
  .rich-text-content :global(a:hover) {
    text-decoration: underline;
  }
  
  .rich-text-content :global(ul), 
  .rich-text-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }
  
  .rich-text-content :global(ul) {
    list-style-type: disc;
  }
  
  .rich-text-content :global(ol) {
    list-style-type: decimal;
  }
  
  .rich-text-content :global(li) {
    margin-bottom: 0.5rem;
  }
  
  .rich-text-content :global(blockquote) {
    border-left: 4px solid var(--color-primary-700);
    padding-left: 1rem;
    font-style: italic;
    margin: 1.5rem 0;
    color: #4b5563;
  }
  
  .rich-text-content :global(pre) {
    background-color: #f3f4f6;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  
  .rich-text-content :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.875rem;
    background-color: #f3f4f6;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
  }
  
  .rich-text-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }
  
  .rich-text-content :global(hr) {
    border: 0;
    border-top: 1px solid #e5e7eb;
    margin: 2rem 0;
  }
  
  .rich-text-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }
  
  .rich-text-content :global(th),
  .rich-text-content :global(td) {
    border: 1px solid #e5e7eb;
    padding: 0.75rem;
    text-align: left;
  }
  
  .rich-text-content :global(th) {
    background-color: #f9fafb;
    font-weight: 600;
  }
  
  /* Styles pour le mode sombre */
  :global(.dark) .rich-text-content :global(h2),
  :global(.dark) .rich-text-content :global(h3) {
    color: #f3f4f6;
  }
  
  :global(.dark) .rich-text-content :global(a) {
    color: var(--color-primary-400, #60a5fa);
  }
  
  :global(.dark) .rich-text-content :global(blockquote) {
    color: #d1d5db;
    border-left-color: var(--color-primary-400, #60a5fa);
  }
  
  :global(.dark) .rich-text-content :global(pre),
  :global(.dark) .rich-text-content :global(code) {
    background-color: #374151;
    color: #e5e7eb;
  }
  
  :global(.dark) .rich-text-content :global(th),
  :global(.dark) .rich-text-content :global(td) {
    border-color: #4b5563;
  }
  
  :global(.dark) .rich-text-content :global(th) {
    background-color: #374151;
  }
  
  :global(.dark) .rich-text-content :global(hr) {
    border-color: #4b5563;
  }
</style>
