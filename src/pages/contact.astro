---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import Breadcrumb from '../components/seo/Breadcrumb.astro';
import Button from '../components/ui/Button.astro';

// Données pour le fil d'Ariane
const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'Contact', url: '/contact', current: true },
];

// FAQ
const faqs = [
  {
    question: "Comment devenir membre de NJI Auto Pro ?",
    answer: "Pour devenir membre, vous devez être un professionnel du secteur automobile (concessionnaire, revendeur, mandataire, etc.). Remplissez notre formulaire de demande d'accès et notre équipe vous contactera sous 24 heures ouvrées pour finaliser votre inscription."
  },
  {
    question: "Quels types de véhicules propose NJI Auto Pro ?",
    answer: "Notre plateforme offre une large gamme de véhicules pour les professionnels : véhicules d'occasion récents, véhicules de direction, véhicules de sociétés, et flottes d'entreprise. Toutes les catégories sont disponibles : citadines, berlines, SUV, utilitaires, etc."
  },
  {
    question: "Dans quels pays NJI Auto Pro est-il présent ?",
    answer: "NJI Auto Pro opère actuellement dans 12 pays européens : France, Allemagne, Espagne, Italie, Belgique, Pays-Bas, Luxembourg, Suisse, Autriche, Portugal, Pologne et République Tchèque."
  },
  {
    question: "Quels sont les délais de livraison des véhicules ?",
    answer: "Les délais varient selon la localisation du véhicule et votre pays. En moyenne, comptez entre 3 et 10 jours ouvrés pour une livraison nationale, et 7 à 15 jours pour une livraison internationale."
  },
  {
    question: "Proposez-vous des garanties sur les véhicules ?",
    answer: "Oui, tous les véhicules bénéficient d'une garantie professionnelle de base de 3 mois. Des extensions de garantie sont disponibles en option, allant jusqu'à 24 mois."
  }
];

// Données des canaux de contact
const contactChannels = [
  {
    title: "Email",
    description: "Notre équipe vous répond sous 24h ouvrées",
    icon: "lucide:mail",
    value: "contact@njiautopro.fr",
    link: "mailto:contact@njiautopro.fr",
    color: "text-blue-500"
  },
  {
    title: "Téléphone",
    description: "Service client disponible 5j/7",
    icon: "lucide:phone",
    value: "+33 1 23 45 67 89",
    link: "tel:+33123456789",
    color: "text-green-500"
  },
  {
    title: "Chat en direct",
    description: "Réponse instantanée",
    icon: "lucide:message-circle",
    value: "Disponible 24/7",
    link: "#chat",
    color: "text-purple-500"
  }
];
---

<BaseLayout
  title="Contact | NJI Auto Pro - Plateforme B2B pour professionnels auto"
  description="Contactez l'équipe NJI Auto Pro. Nous sommes à votre disposition pour répondre à vos questions et vous accompagner dans votre activité automobile B2B."
>
  <div class="container mx-auto px-4 py-8">
    <Breadcrumb items={breadcrumbItems} />
    
    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-12 pb-12">
      <!-- Gradient Background -->
      <div class="absolute inset-0 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-800 z-0"></div>
      
      <!-- Background Pattern -->
      <div class="absolute inset-0 z-0 opacity-20 dark:opacity-10">
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-[var(--color-primary-700)]/30 rounded-full filter blur-3xl"></div>
        <div class="absolute bottom-0 right-0 w-80 h-80 bg-indigo-500/20 rounded-full filter blur-3xl"></div>
      </div>
      
      <!-- Subtle Grid Pattern -->
      <div class="absolute inset-0 z-0 opacity-[0.02] dark:opacity-[0.05]"
        style="background-image: radial-gradient(#3ECF8E 1px, transparent 1px); background-size: 40px 40px;">
      </div>
      
      <div class="relative z-10">
        <div class="text-center mb-12">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] text-sm font-light mb-6">
            <span class="flex h-2 w-2 rounded-full bg-[var(--color-primary-700)] mr-2"></span>
            Contactez-nous
          </div>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-light text-gray-900 dark:text-white mb-6">
            Nous sommes là pour vous aider
          </h1>
          <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto font-light">
            Notre équipe dédiée est à votre disposition pour répondre à vos questions et vous accompagner dans votre activité automobile B2B.
          </p>
        </div>

        <!-- Canaux de contact -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          {contactChannels.map(channel => (
            <div class="bg-white dark:bg-gray-800 p-6 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md transition-all duration-300 group">
              <div class="w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-xl flex items-center justify-center mb-4 group-hover:bg-[var(--color-primary-700)]/20 transition-colors duration-300">
                <Icon name={channel.icon} class={`h-6 w-6 ${channel.color}`} />
              </div>
              <h3 class="text-xl font-light text-gray-900 dark:text-white mb-2">{channel.title}</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-4 font-light">{channel.description}</p>
              <a href={channel.link} class="text-[var(--color-primary-700)] hover:underline font-light inline-flex items-center">
                {channel.value}
                <Icon name="lucide:arrow-right" class="h-4 w-4 ml-2" />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Formulaire de contact -->
    <section class="py-16 bg-white dark:bg-gray-900 rounded-2xl relative overflow-hidden mb-12">
      <!-- Background Pattern -->
      <div class="absolute top-0 right-0 w-1/3 h-1/3 bg-gradient-to-b from-[var(--color-primary-700)]/10 to-transparent rounded-bl-full z-0"></div>
      <div class="absolute bottom-0 left-0 w-1/4 h-1/4 bg-gradient-to-t from-[var(--color-primary-700)]/10 to-transparent rounded-tr-full z-0"></div>
      
      <div class="max-w-4xl mx-auto relative z-10">
        <div class="text-center mb-12">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] text-sm font-light mb-6">
            <span class="flex h-2 w-2 rounded-full bg-[var(--color-primary-700)] mr-2"></span>
            Envoyez-nous un message
          </div>
          <h2 class="text-3xl font-light text-gray-900 dark:text-white mb-4">
            Remplissez le formulaire ci-dessous
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto font-light">
            Nous vous répondrons dans les plus brefs délais pour vous accompagner dans votre projet.
          </p>
        </div>
        
        <form class="space-y-6 bg-white dark:bg-gray-800 p-8 rounded-xl border border-gray-100 dark:border-gray-700">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="nom" class="block text-sm font-light text-gray-700 dark:text-gray-300 mb-1">
                Nom complet*
              </label>
              <input 
                type="text" 
                id="nom" 
                name="nom" 
                class="w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white px-4 py-2.5 font-light"
                required
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-light text-gray-700 dark:text-gray-300 mb-1">
                Email professionnel*
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                class="w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white px-4 py-2.5 font-light"
                required
              />
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="telephone" class="block text-sm font-light text-gray-700 dark:text-gray-300 mb-1">
                Téléphone
              </label>
              <input 
                type="tel" 
                id="telephone" 
                name="telephone" 
                class="w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white px-4 py-2.5 font-light"
              />
            </div>
            <div>
              <label for="entreprise" class="block text-sm font-light text-gray-700 dark:text-gray-300 mb-1">
                Nom de l'entreprise*
              </label>
              <input 
                type="text" 
                id="entreprise" 
                name="entreprise" 
                class="w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white px-4 py-2.5 font-light"
                required
              />
            </div>
          </div>
          
          <div>
            <label for="sujet" class="block text-sm font-light text-gray-700 dark:text-gray-300 mb-1">
              Sujet*
            </label>
            <select 
              id="sujet" 
              name="sujet" 
              class="w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white px-4 py-2.5 font-light"
              required
            >
              <option value="">Sélectionnez un sujet</option>
              <option value="inscription">Demande d'accès à la plateforme</option>
              <option value="information">Informations générales</option>
              <option value="partenariat">Proposition de partenariat</option>
              <option value="assistance">Assistance technique</option>
              <option value="autre">Autre</option>
            </select>
          </div>
          
          <div>
            <label for="message" class="block text-sm font-light text-gray-700 dark:text-gray-300 mb-1">
              Message*
            </label>
            <textarea 
              id="message" 
              name="message" 
              rows="6" 
              class="w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white px-4 py-2.5 font-light"
              required
            ></textarea>
          </div>
          
          <div class="flex items-start">
            <div class="flex items-center h-5">
              <input
                id="privacy"
                type="checkbox"
                class="w-4 h-4 rounded border-gray-300 text-primary focus:ring-primary"
                required
              />
            </div>
            <div class="ml-3 text-sm">
              <label for="privacy" class="text-gray-600 dark:text-gray-400 font-light">
                J'accepte que mes données soient traitées conformément à la <a href="/politique-confidentialite" class="text-primary hover:underline">politique de confidentialité</a>*
              </label>
            </div>
          </div>
          
          <div>
            <Button type="submit" variant="green" size="lg" class="w-full sm:w-auto">
              Envoyer le message
              <Icon name="lucide:arrow-right" class="h-5 w-5 ml-2" />
            </Button>
          </div>
        </form>
      </div>
    </section>

    <!-- Carte et informations -->
    <section class="py-16 bg-gray-50 dark:bg-gray-800/30 rounded-2xl relative overflow-hidden my-12">
      <!-- Background Decoration -->
      <div class="absolute inset-0 z-0 opacity-[0.02] dark:opacity-[0.05]"
        style="background-image: radial-gradient(#3ECF8E 1px, transparent 1px); background-size: 30px 30px;">
      </div>
      
      <div class="relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
          <!-- Carte -->
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border border-gray-100 dark:border-gray-700 overflow-hidden">
            <div class="aspect-[16/9] w-full bg-gray-100 dark:bg-gray-700 rounded-lg flex items-center justify-center">
              <div class="text-center p-8">
                <Icon name="lucide:map" class="h-12 w-12 text-primary mx-auto mb-4" />
                <h4 class="text-lg font-light text-gray-900 dark:text-white mb-2">Notre localisation</h4>
                <p class="text-gray-600 dark:text-gray-400 max-w-md mx-auto font-light">
                  123 Avenue de la République<br>
                  75011 Paris<br>
                  France
                </p>
              </div>
            </div>
          </div>
          
          <!-- Horaires et réseaux sociaux -->
          <div class="space-y-6">
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border border-gray-100 dark:border-gray-700">
              <h3 class="text-xl font-light text-gray-900 dark:text-white mb-6">
                Horaires d'ouverture
              </h3>
              <div class="space-y-4">
                <div class="flex justify-between items-center">
                  <span class="text-gray-600 dark:text-gray-400 font-light">Lundi - Vendredi</span>
                  <span class="text-gray-900 dark:text-white font-light">9h00 - 18h00</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-600 dark:text-gray-400 font-light">Samedi</span>
                  <span class="text-gray-900 dark:text-white font-light">Fermé</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-600 dark:text-gray-400 font-light">Dimanche</span>
                  <span class="text-gray-900 dark:text-white font-light">Fermé</span>
                </div>
              </div>
            </div>
            
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border border-gray-100 dark:border-gray-700">
              <h3 class="text-xl font-light text-gray-900 dark:text-white mb-6">
                Suivez-nous
              </h3>
              <div class="flex space-x-4">
                <a href="#" class="w-10 h-10 rounded-lg bg-[var(--color-primary-700)]/10 flex items-center justify-center text-[var(--color-primary-700)] hover:bg-[var(--color-primary-700)]/20 transition-colors">
                  <Icon name="lucide:linkedin" class="h-5 w-5" />
                </a>
                <a href="#" class="w-10 h-10 rounded-lg bg-[var(--color-primary-700)]/10 flex items-center justify-center text-[var(--color-primary-700)] hover:bg-[var(--color-primary-700)]/20 transition-colors">
                  <Icon name="lucide:facebook" class="h-5 w-5" />
                </a>
                <a href="#" class="w-10 h-10 rounded-lg bg-[var(--color-primary-700)]/10 flex items-center justify-center text-[var(--color-primary-700)] hover:bg-[var(--color-primary-700)]/20 transition-colors">
                  <Icon name="lucide:twitter" class="h-5 w-5" />
                </a>
                <a href="#" class="w-10 h-10 rounded-lg bg-[var(--color-primary-700)]/10 flex items-center justify-center text-[var(--color-primary-700)] hover:bg-[var(--color-primary-700)]/20 transition-colors">
                  <Icon name="lucide:instagram" class="h-5 w-5" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Animation pour les éléments au survol */
  .group:hover {
    transform: translateY(-2px);
  }
</style>
