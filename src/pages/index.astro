---
// Pour activer la protection par mot de passe et permettre le traitement du formulaire,
// cette page doit être rendue côté serveur (SSR).
// Décommentez la ligne ci-dessous si vous utilisez le composant PasswordProtection.
// Lorsque vous supprimez la protection, commentez ou supprimez cette ligne pour revenir au pré-rendu (SSG).
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import { Image } from "astro:assets";
import linearFleet from "../assets/images/linear-fleet.jpeg";
import linearFleetDark from "../assets/images/linear-fleet-dark.jpeg";

// Récupérer les données des véhicules en vedette sans prix (statique ou SSR)
// Cette requête s'exécute au moment du build, excellent pour le SEO
const featuredVehicles = [
  {
    id: "bmw-x5-1",
    brand: "BMW",
    model: "X5",
    year: 2023,
    mileage: 15000,
    fuel: "Diesel",
    image: "/assets/images/vehicles/bmw-x5.jpg",
    highlight: "Finition M-Sport",
  },
  {
    id: "mercedes-c300-1",
    brand: "Mercedes",
    model: "Classe C",
    year: 2022,
    mileage: 22000,
    fuel: "Hybride",
    image: "/assets/images/vehicles/mercedes-c.jpg",
    highlight: "AMG Line",
  },
  {
    id: "audi-q5-1",
    brand: "Audi",
    model: "Q5",
    year: 2023,
    mileage: 18000,
    fuel: "Diesel",
    image: "/assets/images/vehicles/audi-q5.jpg",
    highlight: "S-Line",
  },
];

// Statistiques dynamiques pour créer de la confiance
const stats = {
  vehicleCount: "15K+",
  activeDealers: "500+",
  satisfactionRate: "98%",
  deliveryTime: "24h",
};

// Marques populaires pour la navigation rapide
const popularBrands = [
  "BMW",
  "Mercedes",
  "Audi",
  "Volkswagen",
  "Toyota",
  "Renault",
];

// Catégories de véhicules pour la navigation rapide
const vehicleCategories = [
  { name: "SUV", icon: "lucide:car", count: 5240 },
  { name: "Berlines", icon: "lucide:car", count: 4150 },
  { name: "Break", icon: "lucide:car", count: 2300 },
  { name: "Utilitaires", icon: "lucide:car", count: 3100 },
];
---

<BaseLayout
  title="NJI Auto Pro - Plateforme B2B pour professionnels de l'automobile"
  description="Accédez à notre catalogue exclusif de plus de 15 000 véhicules réservés aux professionnels de l'automobile. Demandez votre accès pro et développez votre activité."
>
  <!-- Hero Section Optimisée - Approche Sourcing Local et Prix Compétitifs -->
  <section id="hero" class="relative overflow-hidden pt-24 pb-20">
    <!-- Fond et effets visuels (inchangés) -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-800 z-0"
    >
    </div>
    <div class="absolute inset-0 z-0 opacity-20 dark:opacity-10">
      <div
        class="absolute -top-24 -left-24 w-96 h-96 bg-[var(--color-primary-700)]/30 rounded-full filter blur-3xl"
      >
      </div>
      <div
        class="absolute top-1/2 right-0 w-80 h-80 bg-indigo-500/20 rounded-full filter blur-3xl"
      >
      </div>
    </div>
    <div class="absolute inset-0 z-0 opacity-20">
      <div class="w-full h-full absolute inset-0 block dark:hidden">
        <Image
          src={linearFleet}
          alt="Véhicules pour professionnels"
          class="w-full h-full object-cover"
          quality={80}
          format="avif"
        />
      </div>
      <div class="w-full h-full absolute inset-0 hidden dark:block">
        <Image
          src={linearFleetDark}
          alt="Véhicules pour professionnels"
          class="w-full h-full object-cover"
          quality={80}
          format="avif"
        />
      </div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Badge localisation -->
        <div
          class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] text-sm font-medium mb-6"
        >
          <span
            class="flex h-2 w-2 rounded-full bg-[var(--color-primary-700)] mr-2"
          ></span>
          Sourcing automobile Sud-Ouest
        </div>

        <!-- Titre principal axé sur les prix et la simplicité -->
        <h1
          class="text-4xl md:text-5xl font-light text-gray-900 dark:text-white tracking-tight mb-6 leading-[1.1]"
        >
          Des véhicules au <span class="text-[var(--color-primary-700)]"
            >meilleur prix</span
          >, clés en main
        </h1>

        <p
          class="text-lg md:text-xl text-gray-600 dark:text-gray-300 mb-10 max-w-3xl mx-auto leading-relaxed"
        >
          NJI Auto Pro source pour vous des modèles généralistes à prix
          compétitifs. Prix tout inclus, transport organisé, transactions
          sécurisées.
        </p>

        <!-- Boutons d'action principaux -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
          <Button
            variant="green"
            size="lg"
            href="https://app.njiautopro.com/auth/register"
            class="px-8 py-4 rounded-md shadow-[var(--color-primary-700)]/20 hover:shadow-[var(--color-primary-700)]/30 transition-all duration-300"
          >
            Demander un accès pro
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ml-2"
              ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </Button>
          <Button
            variant="outline"
            size="lg"
            href="/vehicules"
            class="px-8 py-4 rounded-md border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800"
          >
            Explorer le catalogue
          </Button>
        </div>

        <!-- Avantages concrets -->
        <div
          class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-3xl mx-auto mt-8 mb-6"
        >
          <div
            class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-center mb-2">
              <div class="text-[var(--color-primary-700)] mr-3">
                <Icon name="lucide:tag" class="h-5 w-5" />
              </div>
              <p class="text-sm font-medium text-gray-900 dark:text-white">
                Prix tout inclus
              </p>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400">
              Sans frais cachés, ce que vous voyez est ce que vous payez
            </p>
          </div>

          <div
            class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-center mb-2">
              <div class="text-[var(--color-primary-700)] mr-3">
                <Icon name="lucide:truck" class="h-5 w-5" />
              </div>
              <p class="text-sm font-medium text-gray-900 dark:text-white">
                Transport organisé
              </p>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400">
              Livraison coordonnée vers votre concession
            </p>
          </div>

          <div
            class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-center mb-2">
              <div class="text-[var(--color-primary-700)] mr-3">
                <Icon name="lucide:shield" class="h-5 w-5" />
              </div>
              <p class="text-sm font-medium text-gray-900 dark:text-white">
                Transactions sécurisées
              </p>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400">
              Paiements protégés et sécurisés
            </p>
          </div>
        </div>

        <!-- Texte de qualification avec focus local -->
        <p
          class="text-sm text-gray-500 dark:text-gray-400 mt-2 mb-4 font-light"
        >
          Spécialisé dans la région Sud-Ouest (64, 40, 32, 65) • Réservé aux
          professionnels avec N° SIRET valide
        </p>
      </div>
    </div>
  </section>

  <!-- Navigation Rapide par Catégorie -->
  <section
    class="py-16 bg-white dark:bg-gray-900 border-t border-gray-100 dark:border-gray-800"
  >
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-light text-gray-900 dark:text-white mb-4">
          Explorer par catégorie
        </h2>
        <p
          class="text-gray-600 dark:text-gray-300 max-w-3xl mx-auto font-light"
        >
          Découvrez rapidement les véhicules qui correspondent à votre activité
        </p>
      </div>

      <!-- Navigation par type de véhicule -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
        {
          vehicleCategories.map((category) => (
            <a
              href={`/vehicules?category=${category.name}`}
              class="bg-gray-50 dark:bg-gray-800 rounded-xl p-6 text-center hover:shadow-md transition-all duration-300 group"
            >
              <div class="w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-[var(--color-primary-700)]/20">
                <Icon
                  name={category.icon}
                  class="h-6 w-6 text-[var(--color-primary-700)]"
                />
              </div>
              <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-1">
                {category.name}
              </h3>
              <p class="text-sm text-gray-500 dark:text-gray-400">
                {category.count} véhicules
              </p>
            </a>
          ))
        }
      </div>

      <!-- Navigation par marque -->
      <div class="text-center mb-6 mt-12">
        <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">
          Marques populaires
        </h3>
      </div>

      <div class="grid grid-cols-3 md:grid-cols-6 gap-4">
        {
          popularBrands.map((brand) => (
            <a
              href={`/vehicules?brand=${brand}`}
              class="bg-white dark:bg-gray-800 p-6 rounded-xl flex items-center justify-center border border-gray-100 dark:border-gray-700 hover:shadow-sm hover:border-[var(--color-primary-700)]/30 transition-all duration-300"
            >
              <div class="font-medium text-lg tracking-tight text-gray-900 dark:text-white">
                {brand}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Véhicules en Vedette -->
  <section class="py-16 bg-gray-50 dark:bg-gray-800 relative overflow-hidden">
    <div class="container mx-auto px-4 relative z-10">
      <div class="text-center mb-10">
        <div
          class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] text-sm font-medium mb-6"
        >
          <span
            class="flex h-2 w-2 rounded-full bg-[var(--color-primary-700)] mr-2"
          ></span>
          Sélection exclusive
        </div>
        <h2 class="text-3xl font-light text-gray-900 dark:text-white mb-4">
          Opportunités de la semaine
        </h2>
        <p
          class="text-gray-600 dark:text-gray-300 max-w-3xl mx-auto font-light"
        >
          Découvrez notre sélection des meilleures opportunités actuellement
          disponibles
        </p>
      </div>

      <!-- Grille de véhicules -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {
          featuredVehicles.map((vehicle) => (
            <a href={`/vehicules/${vehicle.id}`} class="group">
              <div class="bg-white dark:bg-gray-900 rounded-xl overflow-hidden shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md hover:border-[var(--color-primary-700)]/30 transition-all duration-300">
                <div class="relative">
                  <img
                    src={vehicle.image}
                    alt={`${vehicle.brand} ${vehicle.model}`}
                    class="w-full h-48 object-cover"
                  />
                  <div class="absolute top-0 right-0 m-2">
                    <span class="bg-[var(--color-primary-700)] text-white text-xs font-medium px-2 py-1 rounded">
                      Exclusivité
                    </span>
                  </div>
                </div>
                <div class="p-4">
                  <h3 class="font-medium text-gray-900 dark:text-white mb-2">
                    {vehicle.brand} {vehicle.model}
                  </h3>
                  <div class="flex justify-between items-center">
                    <p class="text-gray-600 dark:text-gray-400 text-sm">
                      {vehicle.year} • {vehicle.fuel}
                    </p>
                  </div>
                  <div class="flex items-center text-sm text-gray-600 dark:text-gray-400 mt-2">
                    <Icon name="lucide:gauge" class="h-4 w-4 mr-1" />
                    <span>
                      {new Intl.NumberFormat("fr-FR").format(vehicle.mileage)}{" "}
                      km
                    </span>
                  </div>
                  <div class="mt-3 bg-gray-50 dark:bg-gray-800 rounded p-2 text-sm">
                    <span class="font-medium text-[var(--color-primary-700)]">
                      {vehicle.highlight}
                    </span>
                  </div>
                  <div class="mt-4 text-center py-2 border-t border-gray-100 dark:border-gray-700">
                    <span class="text-[var(--color-primary-700)] font-medium">
                      Prix pro
                    </span>
                    <span class="text-xs ml-1 text-gray-500 dark:text-gray-400">
                      (Accès réservé)
                    </span>
                  </div>
                </div>
              </div>
            </a>
          ))
        }
      </div>

      <div class="text-center mt-10">
        <Button
          variant="outline"
          href="/vehicules"
          class="px-6 py-3 border-gray-300 dark:border-gray-600"
        >
          Voir tous les véhicules
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 ml-2"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </Button>
      </div>
    </div>
  </section>

  <!-- Avantages pour les professionnels -->
  <section class="py-16 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <div
          class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] text-sm font-medium mb-6"
        >
          <span
            class="flex h-2 w-2 rounded-full bg-[var(--color-primary-700)] mr-2"
          ></span>
          Pourquoi nous choisir
        </div>
        <h2 class="text-3xl font-light text-gray-900 dark:text-white mb-4">
          Des avantages exclusifs
        </h2>
        <p class="text-gray-600 dark:text-gray-300">
          NJI Auto Pro vous offre tous les outils pour développer votre activité
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <!-- Avantage 1 -->
        <div
          class="bg-gray-50 dark:bg-gray-800 p-8 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md transition-all duration-300 group"
        >
          <div
            class="w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-[var(--color-primary-700)]/20 transition-colors duration-300"
          >
            <Icon
              name="lucide:badge-percent"
              class="h-6 w-6 text-[var(--color-primary-700)]"
            />
          </div>
          <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-3">
            Commission attractive
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            Profitez de commissions compétitives sur chaque transaction réalisée
            via notre plateforme.
          </p>
        </div>

        <!-- Avantage 2 -->
        <div
          class="bg-gray-50 dark:bg-gray-800 p-8 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md transition-all duration-300 group"
        >
          <div
            class="w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-[var(--color-primary-700)]/20 transition-colors duration-300"
          >
            <Icon
              name="lucide:bar-chart"
              class="h-6 w-6 text-[var(--color-primary-700)]"
            />
          </div>
          <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-3">
            Analyse de marché
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            Accédez à des données en temps réel sur les tendances du marché pour
            prendre les meilleures décisions.
          </p>
        </div>

        <!-- Avantage 3 -->
        <div
          class="bg-gray-50 dark:bg-gray-800 p-8 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md transition-all duration-300 group"
        >
          <div
            class="w-12 h-12 bg-[var(--color-primary-700)]/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-[var(--color-primary-700)]/20 transition-colors duration-300"
          >
            <Icon
              name="lucide:shield"
              class="h-6 w-6 text-[var(--color-primary-700)]"
            />
          </div>
          <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-3">
            Transactions sécurisées
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            Toutes les transactions sont vérifiées et sécurisées pour garantir
            une expérience sans risque.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Témoignages -->
  <section class="py-16 bg-gray-50 dark:bg-gray-800">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <div
          class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-primary-700)]/10 text-[var(--color-primary-700)] text-sm font-medium mb-6"
        >
          <span
            class="flex h-2 w-2 rounded-full bg-[var(--color-primary-700)] mr-2"
          ></span>
          Témoignages
        </div>
        <h2 class="text-3xl font-light text-gray-900 dark:text-white mb-4">
          Ils nous font confiance
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div
          class="bg-white dark:bg-gray-900 p-6 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm"
        >
          <div class="flex items-center mb-4">
            <div
              class="w-12 h-12 rounded-full bg-gray-200 dark:bg-gray-700 mr-4"
            >
            </div>
            <div>
              <h4 class="font-medium text-gray-900 dark:text-white">
                Thomas Durand
              </h4>
              <p class="text-sm text-gray-500 dark:text-gray-400">
                Concessionnaire multi-marques
              </p>
            </div>
          </div>
          <p class="text-gray-600 dark:text-gray-300 italic">
            "NJI Auto Pro a transformé notre approche d'achat. L'accès à un
            catalogue aussi varié nous permet de répondre rapidement aux
            demandes de nos clients."
          </p>
        </div>

        <div
          class="bg-white dark:bg-gray-900 p-6 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm"
        >
          <div class="flex items-center mb-4">
            <div
              class="w-12 h-12 rounded-full bg-gray-200 dark:bg-gray-700 mr-4"
            >
            </div>
            <div>
              <h4 class="font-medium text-gray-900 dark:text-white">
                Sophie Martin
              </h4>
              <p class="text-sm text-gray-500 dark:text-gray-400">
                Directrice commerciale automobile
              </p>
            </div>
          </div>
          <p class="text-gray-600 dark:text-gray-300 italic">
            "La simplicité de la plateforme et la transparence des transactions
            font de NJI Auto Pro un partenaire de confiance pour notre groupe."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="py-16 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <div
        class="max-w-4xl mx-auto bg-[var(--color-primary-700)]/5 p-8 md:p-12 rounded-2xl border border-[var(--color-primary-700)]/20 text-center"
      >
        <h2 class="text-3xl font-light text-gray-900 dark:text-white mb-6">
          Prêt à accéder à notre catalogue exclusif?
        </h2>
        <p
          class="text-lg text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto"
        >
          Demandez votre accès professionnel en quelques clics et découvrez tous
          nos véhicules.
        </p>

        <!-- Formulaire de qualification rapide -->
        <form
          class="max-w-xl mx-auto bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm mb-8"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
              <input
                type="text"
                placeholder="Nom de l'entreprise"
                class="w-full px-4 py-3 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                required
              />
            </div>
            <div>
              <input
                type="text"
                placeholder="N° SIRET"
                class="w-full px-4 py-3 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                required
              />
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div>
              <input
                type="email"
                placeholder="Email professionnel"
                class="w-full px-4 py-3 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                required
              />
            </div>
            <div>
              <input
                type="tel"
                placeholder="Téléphone"
                class="w-full px-4 py-3 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                required
              />
            </div>
          </div>
          <Button
            variant="green"
            size="lg"
            type="submit"
            class="w-full px-8 py-3 rounded-md shadow-[var(--color-primary-700)]/20 hover:shadow-[var(--color-primary-700)]/30 transition-all duration-300"
          >
            Demander un accès pro
          </Button>
          <p class="text-xs text-center text-gray-500 dark:text-gray-400 mt-3">
            En soumettant ce formulaire, vous acceptez nos conditions générales
            et notre politique de confidentialité.
          </p>
        </form>

        <div class="flex justify-center space-x-6">
          <div class="flex items-center">
            <Icon
              name="lucide:shield-check"
              class="h-5 w-5 text-[var(--color-primary-700)] mr-2"
            />
            <span class="text-sm text-gray-600 dark:text-gray-300"
              >Vérification sous 24h</span
            >
          </div>
